# From LiveKit Cloud > Settings > API keys (same project the agent is deployed to)
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ACMeSIM-agent

# Shared code your testers type in. Leave empty to disable the check (not recommended once hosted).
TEAM_ACCESS_CODE=change-me
